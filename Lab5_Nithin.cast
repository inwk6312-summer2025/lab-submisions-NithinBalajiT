[567.651457, "o", "\r\n"]
[567.651873, "o", "\r\n"]
[567.652371, "o", "Commands:"]
[567.652753, "o", "\r\n"]
[567.653134, "o", "  install                     Install packages."]
[567.653523, "o", "\r\n"]
[567.653911, "o", "  download                    Download packages."]
[567.654327, "o", "\r\n"]
[567.654703, "o", "  uninstall                   Uninstall packages."]
[567.65511, "o", "\r\n"]
[567.655487, "o", "  freeze                      Output installed packages in requirements format."]
[567.65593, "o", "\r\n"]
[567.656331, "o", "  list                        List installed packages."]
[567.65676, "o", "\r\n"]
[567.657192, "o", "  show                        Show information about installed packages."]
[567.657627, "o", "\r\n"]
[567.658037, "o", "  check                       Verify installed packages have compatible dependencies."]
[567.658436, "o", "\r\n"]
[567.658807, "o", "  config                      Manage local and global configuration."]
