[1720.109104, "o", "\r\n        +--rw type?                identityref\r\n"]
[1720.109483, "o", "        +--rw enabled?             boolean\r\n        +--rw router-id?           yang:dotted-quad {router-id}?"]
[1720.109782, "o", "\r\n        +--rw description?         string"]
[1720.110158, "o", "\r\n        +--rw interfaces\r\n        |  +--rw interface*   if:interface-ref"]
