[1720.112504, "o", "\r\n        |     +--rw name             string\r\n        |     +--rw description?     string"]
[1720.112845, "o", "\r\n        |     +--rw static-routes\r\n        +--rw ribs"]
[1720.113427, "o", "\r\n           +--rw rib* [name]\r\n              +--rw name              string"]
[1720.113694, "o", "\r\n"]
[1720.114016, "o", "              +--rw address-family?   identityref"]
[1720.114257, "o", "\r\n"]
[1720.114679, "o", "              +--rw description?      string\r\n\r\n"]
[1720.115025, "o", "  augment /if:interfaces-state/if:interface:\r\n    +--ro routing-instance?   string"]
[1720.115425, "o", "\r\n\r\n  rpcs:\r\n    +---x fib-route\r\n"]
[1720.115876, "o", "       +---w input\r\n       |  +---w routing-instance-name    string"]
[1720.117082, "o", "\r\n       |  +---w destination-address\r\n"]
[1720.117469, "o", "       |     +---w address-family    identityref\r\n       +--ro output"]
[1720.117911, "o", "\r\n          +--ro route\r\n             +--ro address-family     identityref"]
[1720.118287, "o", "\r\n             +--ro next-hop\r\n             |  +--ro (next-hop-options)"]
[1720.118632, "o", "\r\n             |     +--:(simple-next-hop)\r\n"]
[1720.118985, "o", "             |     |  +--ro outgoing-interface?   string\r\n             |     |  +--ro next-hop-address?     string"]
[1720.119451, "o", "\r\n             |     +--:(special-next-hop)\r\n             |        +--ro special-next-hop?     enumeration\r\n             +--ro source-protocol    identityref"]
[1720.119742, "o", "\r\n             +--ro active?            empty"]
[1720.120108, "o", "\r\n             +--ro last-updated?      yang:date-and-time\r\n"]
