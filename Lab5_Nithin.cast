[1720.105729, "o", "\r\n  |                 |        +--ro special-next-hop?     enumeration"]
[1720.107078, "o", "\r\n  |                 +--ro source-protocol       identityref"]
[1720.107425, "o", "\r\n  |                 +--ro active?               empty"]
[1720.107736, "o", "\r\n  |                 +--ro last-updated?         yang:date-and-time"]
[1720.108139, "o", "\r\n  |                 +--ro update-source?        string\r\n  +--rw routing"]
[1720.10846, "o", "\r\n     +--rw routing-instance* [name]"]
