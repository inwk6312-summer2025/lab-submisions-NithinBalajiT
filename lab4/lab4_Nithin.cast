[4980.573655, "o", "\u001b[?25l\u001b[95m into {host['name']} successfully\"\u001b[m)\r\noutput = net_connect.send_c\u001b[14;28H\u001b[K\u001b[14;28H\u001b[?25h"]
[4980.578241, "o", "\u001b[?25lonfig_set(loopback_config.split(\u001b[95m\"\u001b[m\u001b[38;5;224m\\n\u001b[m\u001b[95m\"\u001b[m))\r\n\u001b[1m\u001b[96mprint\u001b[m(f\u001b[95m\"Pushed config in\u001b[m\u001b[15;25H\u001b[K\u001b[15;25H\u001b[?25h"]
[4980.579218, "o", "\u001b[?25l\u001b[95mto {host['name']} successfully\"\u001b[m)\r\nnet_connect.disconnect()\u001b[16;25H\u001b[K\u001b[17;1H\u001b[1m\u001b[96mprint\u001b[m\u001b[17;6H\u001b[K\u001b[17;6H\u001b[?25h"]
[4980.580052, "o", "\u001b[?25l(\u001b[95m\"Done!\"\u001b[m)\r\nThe Python \u001b[1m\u001b[96mfile\u001b[m \u001b[93mis\u001b[m first reading \u001b[93min\u001b[m the host informat\u001b[18;54H\u001b[K\u001b[18;54H\u001b[?25h"]
[4980.584478, "o", "\u001b[?25lion \u001b[38;5;81mfrom\u001b[m the hosts.yml \u001b[1m\u001b[96mfile\u001b[m. The interface information\r\n\u001b[93mis\u001b[m then \u001b[19;9H\u001b[K\u001b[19;9H\u001b[?25h"]
[4980.585266, "o", "\u001b[?25lread \u001b[38;5;81mfrom\u001b[m the YAML \u001b[1m\u001b[96mfile\u001b[m(interfaces.yml). The host \u001b[93mand\u001b[m interface\u001b[?25h"]
[4980.586369, "o", "\u001b[?25l information are now\r\navailable \u001b[93mas\u001b[m Python dictionaries.\u001b[20;34H\u001b[K\u001b[21;1HNext, we\u001b[21;9H\u001b[K\u001b[21;9H\u001b[?25h"]
[4980.59069, "o", "\u001b[?25l use the Jinja2 library to render the template \u001b[93mwith\u001b[m the variabl\u001b[?25h"]
[4980.59195, "o", "\u001b[?25les. The result of this \u001b[93mis\u001b[m that\r\nloopback_config contains the com\u001b[22;33H\u001b[K\u001b[22;33H\u001b[?25h"]
[4980.593047, "o", "\u001b[?25lpleted (absolute) \u001b[1m\u001b[96mfile\u001b[m \u001b[93mwith\u001b[m \u001b[1m\u001b[96mall\u001b[m loopback information.\r\nNext, we \u001b[23;10H\u001b[K\u001b[23;10H\u001b[?25h"]
[4980.597138, "o", "\u001b[?25lsimply loop over the devices (hosts) \u001b[93mand\u001b[m \u001b[93mfor\u001b[m each host we creat\u001b[?25h"]
[4980.598502, "o", "\u001b[?25le an SSH connection via Netmiko.\r\nFinally, we use the send_confi\u001b[24;31H\u001b[K\u001b[24;31H\u001b[?25h"]
