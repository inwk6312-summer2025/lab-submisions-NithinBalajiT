[4518.805004, "o", "\u001b[1;1Hifrom netmiko \u001b[35mimport\u001b[m Netmiko\r\ndevice = {\u001b[31m\"device_type\"\u001b[m: \u001b[31m\"cisco_ios\"\u001b[m,\r\n \u001b[31m\"ip\"\u001b[m: \u001b[31m\"192.168.1.101\"\u001b[m,\r\n \u001b[31m\"username\"\u001b[m: \u001b[31m\"student\"\u001b[m,\r\n \u001b[31m\"password\"\u001b[m: \u001b[31m\"Meilab123\"\u001b[m,\r\n \u001b[31m\"port\"\u001b[m: \u001b[31m\"22\"\u001b[m}\r\nnet_connect = Netmiko(**device)\r\noutput = net_connect.send_command(\u001b[31m\"show ip interface brief\"\u001b[m, use_textfsm=\u001b[36mTrue\u001b[m)\r\nnet_connect.disconnect()\r\n\u001b[36mprint\u001b[m(\u001b[36mtype\u001b[m(output))\r\n\r\n\u001b[38;5;130mfor\u001b[m interface \u001b[38;5;130min\u001b[m output:\r\n \u001b[36mprint\u001b[m(interface[\u001b[31m'interface'\u001b[m])\r\n\u001b[94m~                                                                                                                       \u001b[15;1H~                                                                                                                       \u001b[16;1H~                                                                                                                       \u001b[17;1H~                                                                                     "]
