[4980.566241, "o", "\u001b[?25l\r\u001b[93mfor\u001b[m host \u001b[93min\u001b[m hosts[\u001b[95m\"hosts\"\u001b[m]:\r\nnet_connect = Netmiko(host = host[\u001b[95m\"nam\u001b[m\u001b[8;39H\u001b[K\u001b[8;39H\u001b[?25h"]
[4980.571492, "o", "\u001b[?25l\u001b[95me\"\u001b[m],\r\nusername = host[\u001b[95m\"username\"\u001b[m],\u001b[9;29H\u001b[K\u001b[10;1Hpassword = host[\u001b[95m\"password\"\u001b[m],\u001b[10;29H\u001b[K\u001b[11;1H\u001b[K\u001b[11;1H\u001b[?25h"]
